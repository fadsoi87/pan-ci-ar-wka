<!DOCTYPE html>
<html lang="pl">

<body>

<header>
    <h1>Albert Einstein</h1>
    <p>Słynny fizyk teoretyczny</p>
</header>

<section>
    <h2>Kim był?</h2>
    <p>
        Albert Einstein był niemieckim fizykiem teoretycznym, który stworzył
        teorię względności. Jest uważany za jednego z największych naukowców w historii.
    </p>  
</section>

<section>
    <h2>Najważniejsze osiągnięcia</h2>
    <ul>
        <li>Teoria względności</li>
        <li>Równanie E = mc²</li>
        <li>Nagroda Nobla w 1921 roku</li>
    </ul>
</section>

<section>
    <h2>Zdjęcie</h2>
    <img id="zdjecie" width="200"
        src="https://upload.wikimedia.org/wikipedia/commons/d/d3/Albert_Einstein_Head.jpg">
</section>

<footer>
    <p>Strona edukacyjna o Albercie Einsteinie</p>
</footer>

<script>
window.onload = function() {
    let zdjecia = [
        "https://upload.wikimedia.org/wikipedia/commons/d/d3/Albert_Einstein_Head.jpg",
        "https://upload.wikimedia.org/wikipedia/commons/8/8f/Einstein_1921_portrait2.jpg",
        "https://upload.wikimedia.org/wikipedia/commons/a/a0/Einstein_patentoffice.jpg"
    ];

    let index = 0;
    let img = document.getElementById("zdjecie");

    img.addEventListener("click", function() {
        index++;
        if (index >= zdjecia.length) index = 0;
        img.src = zdjecia[index];
    });
};
</script>

</body>
</html>
